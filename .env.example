# ==============================================================================
# Lead Reach AI — Environment Configuration Template
# Copy this file to .env and provide your production or local development values:
#   cp .env.example .env
# ==============================================================================

# --- Application Core ---
NODE_ENV=production
PORT=3000
APP_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com

# --- Security & Cryptography ---
# Required: 32+ character random secret for JWT session encryption
# Generate via: openssl rand -base64 32
AUTH_SECRET=your_random_32_char_auth_secret_here

# Required: 32-byte Base64 key for AES-256-GCM encryption of stored API keys
# Generate via: openssl rand -base64 32
APP_ENCRYPTION_KEY=your_random_32_byte_base64_encryption_key_here

# --- PostgreSQL Database (Docker & Local) ---
POSTGRES_USER=leadreach
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=leadreach

# Connection string:
# Local PC development (connecting to Docker DB on port 5432):
# DATABASE_URL="postgresql://leadreach:your_secure_postgres_password_here@localhost:5432/leadreach"
# Docker container network (internal compose network):
DATABASE_URL="postgresql://leadreach:your_secure_postgres_password_here@db:5432/leadreach"

# --- Redis (Queues & Cache) ---
# Local PC development: redis://localhost:6379
# Docker container network: redis://redis:6379
REDIS_URL="redis://redis:6379"

# --- Admin & Registration Policy ---
ADMIN_EMAIL=admin@yourdomain.com
# Registration modes: "public", "invite", "closed"
REGISTRATION_MODE=invite

# --- System SMTP (Transactional Emails & Password Resets) ---
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=no-reply@example.com
SYSTEM_SMTP_PASS=your_smtp_password_here
SYSTEM_SMTP_FROM="Lead Reach AI <no-reply@example.com>"

# --- AI & Lead Enrichment Providers (Optional / Admin Configurable) ---
OPENAI_API_KEY=
DEFAULT_TEXT_MODEL=gpt-4o-mini
DEFAULT_IMAGE_MODEL=dall-e-3
APIFY_TOKEN=

# --- OAuth & Social Media Providers (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Storage & Operations ---
STORAGE_PATH=/data/uploads
BACKUP_RETENTION_DAYS=7
LOG_LEVEL=info

